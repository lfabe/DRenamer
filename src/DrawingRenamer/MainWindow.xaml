<Window x:Class="DrawingRenamer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:local="using:DrawingRenamer">
    <Grid x:Name="Root" Padding="20,16" RowSpacing="12" Language="ru-RU" AllowDrop="True"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <local:QueueColumns x:Key="FileQueueColumns"/>
            <Style x:Key="QueueGripStyle" TargetType="primitives:Thumb">
                <Setter Property="IsTabStop" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="primitives:Thumb">
                            <Grid Background="Transparent">
                                <Border Width="1" Height="14" Background="{ThemeResource ControlStrokeColorDefaultBrush}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="QueueDividerStyle" TargetType="local:QueueColumnDivider">
                <Setter Property="Width" Value="10"/>
                <Setter Property="Margin" Value="0,0,-5,0"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock Text="Drawing Renamer" Style="{StaticResource TitleTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Журнал" Click="ShowHistory"/>
                <Button Content="Настройки">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <ContentControl x:Name="SettingsContainer" IsTabStop="False">
                            <StackPanel Spacing="10" MinWidth="260">
                                <ComboBox Header="Тема" SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Системная"/><ComboBoxItem Content="Светлая"/>
                                    <ComboBoxItem Content="Тёмная"/>
                                </ComboBox>
                                <StackPanel DataContext="{x:Bind ViewModel}" Spacing="4" MaxWidth="340">
                                    <TextBox x:Name="SeparatorInput" Header="Разделитель имени файла"
                                             Text="{Binding SeparatorInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.HelpText="От одного до трёх знаков или обычных пробелов. Буквы и цифры запрещены."/>
                                    <TextBlock Text="От 1 до 3 знаков или пробелов. Без букв и цифр."
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SeparatorError}" TextWrapping="Wrap"
                                               AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                                <ToggleSwitch Header="Распознавание OCR" IsOn="{x:Bind ViewModel.OcrEnabled, Mode=TwoWay}"
                                              OnContent="Включено" OffContent="Выключено"/>
                                <ComboBox Header="Языки OCR" SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Русский" Tag="rus"/>
                                    <ComboBoxItem Content="Русский и английский" Tag="rus+eng"/>
                                    <ComboBoxItem Content="Английский" Tag="eng"/>
                                </ComboBox>
                                <StackPanel Spacing="4" MaxWidth="340">
                                    <Button Content="Папка сканера…" Click="PickScannerFolder"/>
                                    <TextBlock Text="{x:Bind ViewModel.ScannerFolderLabel, Mode=OneWay}" TextWrapping="Wrap"
                                               ToolTipService.ToolTip="{x:Bind ViewModel.ScannerFolderLabel, Mode=OneWay}"/>
                                    <ToggleSwitch Header="Автораспознавание сканов" OnContent="Включено" OffContent="Выключено"
                                                  IsOn="{x:Bind ViewModel.ScannerWatchEnabled, Mode=TwoWay}"
                                                  IsEnabled="{x:Bind ViewModel.HasScannerFolder, Mode=OneWay}"
                                                  ToolTipService.ToolTip="При разбиении пачек сканы добавляются в очередь для ручного запуска распознавания."/>
                                    <CalendarDatePicker x:Name="ScannerStartDatePicker" Header="Принимать файлы, созданные с"
                                                        DateChanged="ScannerStartDateChanged"/>
                                    <TimePicker x:Name="ScannerStartTimePicker" Header="Время" ClockIdentifier="24HourClock"
                                                TimeChanged="ScannerStartTimeChanged"/>
                                    <ToggleSwitch Header="Разбивать пачки PDF" OnContent="Включено" OffContent="Выключено"
                                                  IsOn="{x:Bind ViewModel.SplitScanBatches, Mode=TwoWay}"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.TemplateLabel, Mode=OneWay}" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Добавить JSON" Click="PickTemplates"/>
                                    <Button x:Name="SaveSettingsButton" Content="Сохранить" Click="SaveSettings"
                                            Style="{StaticResource AccentButtonStyle}"/>
                                    <Button Content="Сбросить" Click="ResetSettings"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.SettingsMessage, Mode=OneWay}" TextWrapping="Wrap"
                                           MaxWidth="340" AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                            </ContentControl>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="AddFilesButton" Content="Добавить PDF" Click="PickFiles"/>
                <Button x:Name="AddFolderButton" Content="Добавить папку" Click="PickFolder"/>
                <CheckBox x:Name="RecursiveCheckBox" Content="Вложенные папки" IsChecked="{x:Bind ViewModel.Recursive, Mode=TwoWay}"/>
                <Button x:Name="RefreshButton" Content="↻ Обновить" Click="RefreshDocuments"
                        ToolTipService.ToolTip="Обновить список документов (F5)">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5"/>
                    </Button.KeyboardAccelerators>
                </Button>
                <Button x:Name="AnalyzeButton" Content="Распознать" Command="{x:Bind ViewModel.AnalyzeCommand}"/>
                <Button x:Name="ConfirmButton" Content="Подтвердить" Click="ConfirmSelected"
                        ToolTipService.ToolTip="Подтвердить значения во всех отмеченных файлах"/>
                <Button x:Name="CancelButton" Content="Остановить анализ" Visibility="Collapsed"
                        Command="{x:Bind ViewModel.CancelCommand}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="UndoButton" Content="Отменить переименование" Click="Undo" IsEnabled="False"/>
                <Button x:Name="RenameButton" Content="Переименовать" Style="{StaticResource AccentButtonStyle}" Click="Rename"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="6*"/><ColumnDefinition Width="5*"/></Grid.ColumnDefinitions>
            <Border SizeChanged="QueueSizeChanged" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <Grid RowSpacing="8" Width="{Binding TableWidth, Source={StaticResource FileQueueColumns}}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid x:Name="QueueHeader" Padding="12,12,20,4" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="{Binding Width1, Source={StaticResource FileQueueColumns}}"/>
                            <ColumnDefinition Width="{Binding Width2, Source={StaticResource FileQueueColumns}}"/>
                            <ColumnDefinition Width="{Binding Width3, Source={StaticResource FileQueueColumns}}"/>
                            <ColumnDefinition Width="{Binding Width4, Source={StaticResource FileQueueColumns}}"/>
                            <ColumnDefinition Width="{Binding Width5, Source={StaticResource FileQueueColumns}}"/>
                            <ColumnDefinition Width="{Binding Width6, Source={StaticResource FileQueueColumns}}"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="AllFilesCheckBox" Click="ToggleAllFiles" IsThreeState="True" MinWidth="0" Padding="0"
                                  AutomationProperties.Name="Отметить все файлы" ToolTipService.ToolTip="Отметить или снять отметки со всех файлов"/>
                        <TextBlock Grid.Column="{Binding SourceIndex, Source={StaticResource FileQueueColumns}}" VerticalAlignment="Center" Text="Исходное имя"
                                   TextTrimming="CharacterEllipsis" IsHitTestVisible="False" Style="{StaticResource CaptionTextBlockStyle}"/>
                        <Border Grid.Column="{Binding SourceIndex, Source={StaticResource FileQueueColumns}}" Tag="Source" Background="Transparent" PointerPressed="BeginColumnMove" PointerMoved="TrackColumnMove" PointerReleased="FinishColumnMove" PointerCaptureLost="CancelColumnMove"/>
                        <local:QueueColumnDivider Grid.Column="{Binding SourceIndex, Source={StaticResource FileQueueColumns}}" Style="{StaticResource QueueDividerStyle}" Canvas.ZIndex="1">
                            <primitives:Thumb Tag="Source" Style="{StaticResource QueueGripStyle}" DragDelta="ResizeQueueColumn"
                                              KeyDown="ResizeQueueColumnKey" DoubleTapped="AutoFitQueueColumn" AutomationProperties.Name="Ширина столбца «Исходное имя»"/>
                        </local:QueueColumnDivider>
                        <TextBlock Grid.Column="{Binding DesignationIndex, Source={StaticResource FileQueueColumns}}" VerticalAlignment="Center" Text="Обозначение"
                                   TextTrimming="CharacterEllipsis" IsHitTestVisible="False" Style="{StaticResource CaptionTextBlockStyle}"/>
                        <Border Grid.Column="{Binding DesignationIndex, Source={StaticResource FileQueueColumns}}" Tag="Designation" Background="Transparent" PointerPressed="BeginColumnMove" PointerMoved="TrackColumnMove" PointerReleased="FinishColumnMove" PointerCaptureLost="CancelColumnMove"/>
                        <local:QueueColumnDivider Grid.Column="{Binding DesignationIndex, Source={StaticResource FileQueueColumns}}" Style="{StaticResource QueueDividerStyle}" Canvas.ZIndex="1">
                            <primitives:Thumb Tag="Designation" Style="{StaticResource QueueGripStyle}" DragDelta="ResizeQueueColumn"
                                              KeyDown="ResizeQueueColumnKey" DoubleTapped="AutoFitQueueColumn" AutomationProperties.Name="Ширина столбца «Обозначение»"/>
                        </local:QueueColumnDivider>
                        <TextBlock Grid.Column="{Binding TitleIndex, Source={StaticResource FileQueueColumns}}" VerticalAlignment="Center" Text="Наименование"
                                   TextTrimming="CharacterEllipsis" IsHitTestVisible="False" Style="{StaticResource CaptionTextBlockStyle}"/>
                        <Border Grid.Column="{Binding TitleIndex, Source={StaticResource FileQueueColumns}}" Tag="Title" Background="Transparent" PointerPressed="BeginColumnMove" PointerMoved="TrackColumnMove" PointerReleased="FinishColumnMove" PointerCaptureLost="CancelColumnMove"/>
                        <local:QueueColumnDivider Grid.Column="{Binding TitleIndex, Source={StaticResource FileQueueColumns}}" Style="{StaticResource QueueDividerStyle}" Canvas.ZIndex="1">
                            <primitives:Thumb Tag="Title" Style="{StaticResource QueueGripStyle}" DragDelta="ResizeQueueColumn"
                                              KeyDown="ResizeQueueColumnKey" DoubleTapped="AutoFitQueueColumn" AutomationProperties.Name="Ширина столбца «Наименование»"/>
                        </local:QueueColumnDivider>
                        <TextBlock Grid.Column="{Binding SheetIndex, Source={StaticResource FileQueueColumns}}" VerticalAlignment="Center" Text="Лист"
                                   TextTrimming="CharacterEllipsis" IsHitTestVisible="False" Style="{StaticResource CaptionTextBlockStyle}"/>
                        <Border Grid.Column="{Binding SheetIndex, Source={StaticResource FileQueueColumns}}" Tag="Sheet" Background="Transparent" PointerPressed="BeginColumnMove" PointerMoved="TrackColumnMove" PointerReleased="FinishColumnMove" PointerCaptureLost="CancelColumnMove"/>
                        <local:QueueColumnDivider Grid.Column="{Binding SheetIndex, Source={StaticResource FileQueueColumns}}" Style="{StaticResource QueueDividerStyle}" Canvas.ZIndex="1">
                            <primitives:Thumb Tag="Sheet" Style="{StaticResource QueueGripStyle}" DragDelta="ResizeQueueColumn"
                                              KeyDown="ResizeQueueColumnKey" DoubleTapped="AutoFitQueueColumn" AutomationProperties.Name="Ширина столбца «Лист»"/>
                        </local:QueueColumnDivider>
                        <TextBlock Grid.Column="{Binding TargetIndex, Source={StaticResource FileQueueColumns}}" VerticalAlignment="Center" Text="Новое имя"
                                   TextTrimming="CharacterEllipsis" IsHitTestVisible="False" Style="{StaticResource CaptionTextBlockStyle}"/>
                        <Border Grid.Column="{Binding TargetIndex, Source={StaticResource FileQueueColumns}}" Tag="Target" Background="Transparent" PointerPressed="BeginColumnMove" PointerMoved="TrackColumnMove" PointerReleased="FinishColumnMove" PointerCaptureLost="CancelColumnMove"/>
                        <local:QueueColumnDivider Grid.Column="{Binding TargetIndex, Source={StaticResource FileQueueColumns}}" Style="{StaticResource QueueDividerStyle}" Canvas.ZIndex="1">
                            <primitives:Thumb Tag="Target" Style="{StaticResource QueueGripStyle}" DragDelta="ResizeQueueColumn"
                                              KeyDown="ResizeQueueColumnKey" DoubleTapped="AutoFitQueueColumn" AutomationProperties.Name="Ширина столбца «Новое имя»"/>
                        </local:QueueColumnDivider>
                        <TextBlock Grid.Column="{Binding StatusIndex, Source={StaticResource FileQueueColumns}}" VerticalAlignment="Center" Text="Статус"
                                   TextTrimming="CharacterEllipsis" IsHitTestVisible="False" Style="{StaticResource CaptionTextBlockStyle}"/>
                        <Border Grid.Column="{Binding StatusIndex, Source={StaticResource FileQueueColumns}}" Tag="Status" Background="Transparent" PointerPressed="BeginColumnMove" PointerMoved="TrackColumnMove" PointerReleased="FinishColumnMove" PointerCaptureLost="CancelColumnMove"/>
                        <local:QueueColumnDivider Grid.Column="{Binding StatusIndex, Source={StaticResource FileQueueColumns}}" Style="{StaticResource QueueDividerStyle}" Canvas.ZIndex="1">
                            <primitives:Thumb Tag="Status" Style="{StaticResource QueueGripStyle}" DragDelta="ResizeQueueColumn"
                                              KeyDown="ResizeQueueColumnKey" DoubleTapped="AutoFitQueueColumn" AutomationProperties.Name="Ширина столбца «Статус»"/>
                        </local:QueueColumnDivider>
                        <Canvas Grid.ColumnSpan="7" Margin="-12,0,-20,0" Canvas.ZIndex="2" IsHitTestVisible="False">
                            <Border x:Name="ColumnMoveGuide" Width="2" Height="22" Visibility="Collapsed" Background="{ThemeResource AccentFillColorDefaultBrush}"/>
                        </Canvas>
                    </Grid>
                    <ListView x:Name="Documents" Grid.Row="1" SelectionMode="Extended"
                              SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}" SelectionChanged="SelectionChanged"
                              KeyDown="DocumentsKeyDown" AutomationProperties.Name="Документы">
                        <ListView.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Light">
                                        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#E5F3FF"/>
                                        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#CCE8FF"/>
                                        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#CCE8FF"/>
                                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#B9DEFF"/>
                                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#B9DEFF"/>
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Dark">
                                        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#283A4B"/>
                                        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#344B60"/>
                                        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#344B60"/>
                                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#405B73"/>
                                        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#405B73"/>
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                            </ResourceDictionary>
                        </ListView.Resources>
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate><ItemsStackPanel ItemsUpdatingScrollMode="KeepScrollOffset"/></ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection><AddDeleteThemeTransition/><ReorderThemeTransition/></TransitionCollection>
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:DocumentRow">
                                <Grid ColumnSpacing="8" MinHeight="44" Padding="12,0" Background="Transparent"
                                      AutomationProperties.Name="{x:Bind OriginalName, Mode=OneWay}">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Распознать" Tag="{x:Bind}" Click="AnalyzeDocumentFromMenu" Visibility="{x:Bind IsFile}"/>
                                            <MenuFlyoutItem Text="Разбить" Tag="{x:Bind}" Click="SplitFromMenu" Visibility="{x:Bind IsFile}"/>
                                            <MenuFlyoutItem Text="Убрать из группы" Tag="{x:Bind}" Click="DetachMergePage"
                                                            Visibility="{x:Bind ManuallyAssigned, Mode=OneWay}"/>
                                            <MenuFlyoutItem Text="{x:Bind RemoveQueueLabel}" Tag="{x:Bind}" Click="RemoveDocumentFromMenu"/>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition Width="{Binding Width1, Source={StaticResource FileQueueColumns}}"/>
                                        <ColumnDefinition Width="{Binding Width2, Source={StaticResource FileQueueColumns}}"/>
                                        <ColumnDefinition Width="{Binding Width3, Source={StaticResource FileQueueColumns}}"/>
                                        <ColumnDefinition Width="{Binding Width4, Source={StaticResource FileQueueColumns}}"/>
                                        <ColumnDefinition Width="{Binding Width5, Source={StaticResource FileQueueColumns}}"/>
                                        <ColumnDefinition Width="{Binding Width6, Source={StaticResource FileQueueColumns}}"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="7" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="4" IsHitTestVisible="False"
                                            Visibility="{x:Bind IsQueueDropTarget, Mode=OneWay}"/>
                                    <CheckBox IsChecked="{x:Bind Included, Mode=TwoWay}" MinWidth="0" Padding="0"
                                              Visibility="{x:Bind IsFile}"
                                              AutomationProperties.Name="{x:Bind OriginalName, Mode=OneWay}"/>
                                    <Grid Grid.Column="{Binding SourceIndex, Source={StaticResource FileQueueColumns}}" Visibility="{x:Bind IsFile}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid Width="22" Visibility="{x:Bind InMergeProposal, Mode=OneWay}" IsHitTestVisible="False">
                                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <Border Width="1" HorizontalAlignment="Left" Margin="4,0,0,0" Background="{ThemeResource TextFillColorTertiaryBrush}"/>
                                            <Border Grid.Row="1" Width="12" Height="1" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    Margin="4,0,0,0" Background="{ThemeResource TextFillColorTertiaryBrush}"/>
                                            <Border Grid.Row="1" Width="1" HorizontalAlignment="Left" Margin="4,0,0,0"
                                                    Background="{ThemeResource TextFillColorTertiaryBrush}" Visibility="{x:Bind ShowBranchContinuation, Mode=OneWay}"/>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{x:Bind OriginalName, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Source, Mode=OneWay}"/>
                                    </Grid>
                                    <TextBlock Grid.Column="{Binding DesignationIndex, Source={StaticResource FileQueueColumns}}" Text="{x:Bind Designation, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="{Binding TitleIndex, Source={StaticResource FileQueueColumns}}" Text="{x:Bind DocumentName, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="{Binding SheetIndex, Source={StaticResource FileQueueColumns}}" Text="{x:Bind SheetNumberText, Mode=OneWay}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="{Binding TargetIndex, Source={StaticResource FileQueueColumns}}" Text="{x:Bind QueueNewName, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind QueueNewName, Mode=OneWay}"/>
                                    <TextBlock Grid.Column="{Binding StatusIndex, Source={StaticResource FileQueueColumns}}" Text="{x:Bind QueueStatus, Mode=OneWay}" TextWrapping="Wrap"
                                               VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                                               ToolTipService.ToolTip="{x:Bind Diagnostic, Mode=OneWay}"
                                               AutomationProperties.HelpText="{x:Bind Diagnostic, Mode=OneWay}"/>
                                    <Button Grid.Column="{Binding GroupIndex, Source={StaticResource FileQueueColumns}}" Grid.ColumnSpan="{Binding GroupSpan, Source={StaticResource FileQueueColumns}}" Content="{x:Bind GroupLabel, Mode=OneWay}" Tag="{x:Bind}" Click="ToggleMergeGroup"
                                            Visibility="{x:Bind IsMergeHeader}" HorizontalAlignment="Left"
                                            Padding="4,3,8,3" FontWeight="SemiBold" ToolTipService.ToolTip="Свернуть или раскрыть листы"/>
                                    <Button Grid.Column="{Binding StatusIndex, Source={StaticResource FileQueueColumns}}" Content="Объединить" Tag="{x:Bind}" Click="MergeSelected" Padding="7,4"
                                            Visibility="{x:Bind IsMergeHeader}" IsEnabled="{x:Bind MergeEnabled, Mode=OneWay}"
                                            Style="{StaticResource AccentButtonStyle}" ToolTipService.ToolTip="{x:Bind Diagnostic, Mode=OneWay}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyQueue" Grid.Row="1" Text="Перетащите PDF-файлы или папки в окно."
                               TextWrapping="Wrap" TextAlignment="Center" Margin="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid Padding="12" RowSpacing="9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Просмотр листа" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                            <Button x:Name="PreviousButton" Content="‹" Click="PreviousPage" IsEnabled="False" AutomationProperties.Name="Предыдущий лист"/>
                            <TextBlock x:Name="PageLabel" Text="—" MinWidth="40" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Button x:Name="NextButton" Content="›" Click="NextPage" IsEnabled="False" AutomationProperties.Name="Следующий лист"/>
                            <Button Content="−" Click="ZoomOut" AutomationProperties.Name="Уменьшить масштаб"/>
                            <Button Content="+" Click="ZoomIn" AutomationProperties.Name="Увеличить масштаб"/>
                            <Button x:Name="RotateLeftButton" Content="↶" Click="RotateLeft" IsEnabled="False"
                                    AutomationProperties.Name="Повернуть лист на 90° влево" ToolTipService.ToolTip="Повернуть лист на 90° влево"/>
                            <Button x:Name="RotateRightButton" Content="↷" Click="RotateRight" IsEnabled="False"
                                    AutomationProperties.Name="Повернуть лист на 90° вправо" ToolTipService.ToolTip="Повернуть лист на 90° вправо"/>
                            <Button x:Name="FitPageButton" Click="FitPage" IsEnabled="False"
                                    AutomationProperties.Name="Вписать страницу целиком" ToolTipService.ToolTip="Вписать страницу целиком">
                                <FontIcon Glyph="&#xE9A6;" FontSize="16"/>
                            </Button>
                            <Button x:Name="FitStampButton" Click="FitStamp" IsEnabled="False"
                                    AutomationProperties.Name="Вписать по штампу" ToolTipService.ToolTip="Вписать по штампу">
                                <FontIcon Glyph="&#xE91B;" FontSize="16"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" MinHeight="140" CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Grid>
                            <ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                          PointerWheelChanged="ScrollPreviewHorizontally"
                                          ZoomMode="Enabled" MinZoomFactor=".25" MaxZoomFactor="5">
                                <Canvas x:Name="SheetExtent" HorizontalAlignment="Center" VerticalAlignment="Top"
                                        PointerWheelChanged="ScrollPreviewHorizontally">
                                    <Canvas x:Name="Sheet" Background="White" RenderTransformOrigin="0.5,0.5"
                                            PointerPressed="RegionPressed" PointerMoved="RegionMoved" PointerReleased="RegionReleased"
                                            PointerCaptureLost="RegionCaptureLost">
                                        <Canvas.RenderTransform><RotateTransform x:Name="SheetRotation"/></Canvas.RenderTransform>
                                        <Image x:Name="PageImage" Stretch="Fill" IsHitTestVisible="False"
                                               AutomationProperties.Name="Изображение листа PDF"/>
                                        <Canvas x:Name="Overlays" IsHitTestVisible="False"/>
                                    </Canvas>
                                </Canvas>
                            </ScrollViewer>
                            <TextBlock x:Name="PreviewMessage" Text="Выберите PDF в списке." TextWrapping="Wrap"
                                       Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="RegionControls" Grid.Row="2" Spacing="5" Visibility="Collapsed">
                        <InfoBar x:Name="ManualRegionsNotice" Severity="Warning" IsClosable="False"
                                 Title="Нужно уточнить графы" Message="Обведите графы на листе или заполните поля ниже.">
                            <InfoBar.ActionButton>
                                <Button x:Name="StartManualRegionsButton" Content="Выделить графы"
                                        Style="{StaticResource AccentButtonStyle}" Click="StartManualRegions"/>
                            </InfoBar.ActionButton>
                        </InfoBar>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button x:Name="ToggleRegionsButton" Content="Выделить графы" Click="ToggleRegions"/>
                            <StackPanel x:Name="RegionActions" Orientation="Horizontal" Spacing="5" Visibility="Collapsed">
                                <ToggleButton x:Name="MarkDesignationButton" Content="Обозначение" Click="MarkDesignation"/>
                                <ToggleButton x:Name="MarkNameButton" Content="Наименование" Click="MarkName"/>
                                <ToggleButton x:Name="MarkStampButton" Content="Рамка штампа" Click="MarkStamp"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="RegionReadActions" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                            <ComboBox x:Name="Orientation" SelectedIndex="0"
                                      AutomationProperties.Name="Дополнительный поворот текста относительно просмотра"
                                      ToolTipService.ToolTip="Дополнительный поворот текста относительно просмотра. Если текст уже расположен правильно, оставьте 0°.">
                                <ComboBoxItem Content="0°"/><ComboBoxItem Content="90°"/>
                                <ComboBoxItem Content="180°"/><ComboBoxItem Content="270°"/>
                            </ComboBox>
                            <Button x:Name="ReadRegionsButton" Content="Прочитать графы" Click="ReadRegions"/>
                            <Button x:Name="SaveRegionsButton" Content="Сохранить в JSON" Click="SaveRegions"/>
                        </StackPanel>
                        <TextBlock x:Name="RegionHint" TextWrapping="Wrap" Visibility="Collapsed"
                                   Style="{StaticResource CaptionTextBlockStyle}" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Spacing="7">
                    <StackPanel x:Name="MergeDetails" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="Порядок объединения" FontWeight="SemiBold"/>
                        <ScrollViewer MaxHeight="92" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="MergeOrder" TextWrapping="Wrap"/>
                        </ScrollViewer>
                        <TextBlock x:Name="MergeDestination" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel x:Name="Editor" Spacing="7" Visibility="Collapsed">
                        <ComboBox x:Name="CandidatePicker" Header="Варианты распознавания" Visibility="Collapsed"
                                  HorizontalAlignment="Stretch" SelectionChanged="CandidateChanged"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBox Header="Обозначение" Text="{Binding Designation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" LostFocus="MergeFieldsChanged"/>
                            <TextBox Grid.Column="1" Header="Наименование" Text="{Binding DocumentName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" LostFocus="MergeFieldsChanged"/>
                        </Grid>
                        <TextBox x:Name="SheetNumberInput" Header="Номер листа" Width="120" HorizontalAlignment="Left"
                                 Text="{Binding SheetNumberText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 LostFocus="MergeFieldsChanged" Visibility="Collapsed"/>
                        <TextBlock Text="{Binding Diagnostic, Mode=OneWay}" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <Button HorizontalAlignment="Right" Content="Подтвердить значения" Click="ConfirmValues"/>
                    </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="3" ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
            <TextBlock TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionTextBlockStyle}">
                <Run Text="{x:Bind ViewModel.Message, Mode=OneWay}"/><Run x:Name="AnalysisClockText"/>
            </TextBlock>
            <ProgressBar Grid.Column="1" Value="{x:Bind ViewModel.Progress, Mode=OneWay}" Maximum="100"
                         AutomationProperties.Name="Ход обработки"/>
        </Grid>
    </Grid>
</Window>

<Window x:Class="DrawingRenamer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DrawingRenamer">
    <Grid x:Name="Root" Padding="20,16" RowSpacing="12" Language="ru-RU"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock Text="Drawing Renamer" Style="{StaticResource TitleTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="Журнал" Click="ShowHistory"/>
                <Button Content="Настройки">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Spacing="10" MinWidth="260">
                                <ComboBox Header="Тема" SelectedIndex="0" SelectionChanged="ThemeChanged">
                                    <ComboBoxItem Content="Системная"/><ComboBoxItem Content="Светлая"/>
                                    <ComboBoxItem Content="Тёмная"/>
                                </ComboBox>
                                <ToggleSwitch Header="Распознавание OCR" IsOn="{x:Bind ViewModel.OcrEnabled, Mode=TwoWay}"
                                              OnContent="Включено" OffContent="Выключено"/>
                                <ComboBox Header="Языки OCR" SelectedIndex="0" SelectionChanged="LanguageChanged">
                                    <ComboBoxItem Content="Русский и английский" Tag="rus+eng"/>
                                    <ComboBoxItem Content="Русский" Tag="rus"/><ComboBoxItem Content="Английский" Tag="eng"/>
                                </ComboBox>
                                <TextBlock Text="{x:Bind ViewModel.TemplateLabel, Mode=OneWay}" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Добавить JSON" Click="PickTemplates"/>
                                    <Button Content="Сбросить" Click="ResetTemplates"/>
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="AddFilesButton" Content="Добавить PDF" Click="PickFiles"/>
                <Button x:Name="AddFolderButton" Content="Добавить папку" Click="PickFolder"/>
                <CheckBox x:Name="RecursiveCheckBox" Content="Вложенные папки" IsChecked="{x:Bind ViewModel.Recursive, Mode=TwoWay}"/>
                <Button x:Name="RefreshButton" Content="↻ Обновить" Click="RefreshDocuments"
                        ToolTipService.ToolTip="Обновить список документов (F5)">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F5"/>
                    </Button.KeyboardAccelerators>
                </Button>
                <Button x:Name="AnalyzeButton" Content="Распознать" Command="{x:Bind ViewModel.AnalyzeCommand}"/>
                <Button x:Name="CancelButton" Content="Остановить анализ" Visibility="Collapsed"
                        Command="{x:Bind ViewModel.CancelCommand}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="UndoButton" Content="Отменить переименование" Click="Undo"/>
                <Button x:Name="RenameButton" Content="Переименовать" Style="{StaticResource AccentButtonStyle}" Click="Rename"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="6*"/><ColumnDefinition Width="5*"/></Grid.ColumnDefinitions>
            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Padding="12,12,20,4" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="92"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Исходное имя" Style="{StaticResource CaptionTextBlockStyle}"/>
                        <TextBlock Grid.Column="2" Text="Обозначение" Style="{StaticResource CaptionTextBlockStyle}"/>
                        <TextBlock Grid.Column="3" Text="Наименование" Style="{StaticResource CaptionTextBlockStyle}"/>
                        <TextBlock Grid.Column="4" Text="Новое имя" Style="{StaticResource CaptionTextBlockStyle}"/>
                        <TextBlock Grid.Column="5" Text="Статус" Style="{StaticResource CaptionTextBlockStyle}"/>
                    </Grid>
                    <ListView x:Name="Documents" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Rows}"
                              SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}" SelectionChanged="SelectionChanged"
                              AutomationProperties.Name="Документы">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="12,0,12,0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:DocumentRow">
                                <Grid ColumnSpacing="8" MinHeight="44" AutomationProperties.Name="{x:Bind OriginalName, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="92"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{x:Bind Included, Mode=TwoWay}" MinWidth="0" Padding="0"
                                              AutomationProperties.Name="{x:Bind OriginalName, Mode=OneWay}"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind OriginalName, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Source, Mode=OneWay}"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Designation, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{x:Bind DocumentName, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{x:Bind NewName, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind NewName, Mode=OneWay}"/>
                                    <TextBlock Grid.Column="5" Text="{x:Bind Status, Mode=OneWay}" TextWrapping="Wrap"
                                               VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EmptyQueue" Grid.Row="1" Text="Добавленные PDF появятся здесь."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </Border>
            <Border Grid.Column="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid Padding="12" RowSpacing="9">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Просмотр листа" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                            <Button x:Name="PreviousButton" Content="‹" Click="PreviousPage" IsEnabled="False" AutomationProperties.Name="Предыдущий лист"/>
                            <TextBlock x:Name="PageLabel" Text="—" MinWidth="40" TextAlignment="Center" VerticalAlignment="Center"/>
                            <Button x:Name="NextButton" Content="›" Click="NextPage" IsEnabled="False" AutomationProperties.Name="Следующий лист"/>
                            <Button Content="−" Click="ZoomOut" AutomationProperties.Name="Уменьшить масштаб"/>
                            <Button Content="+" Click="ZoomIn" AutomationProperties.Name="Увеличить масштаб"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" MinHeight="140" CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Grid>
                            <ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                          ZoomMode="Enabled" MinZoomFactor=".25" MaxZoomFactor="5">
                                <Canvas x:Name="Sheet" HorizontalAlignment="Center" VerticalAlignment="Top" Background="White"
                                        PointerPressed="RegionPressed" PointerMoved="RegionMoved" PointerReleased="RegionReleased"
                                        PointerCaptureLost="RegionCaptureLost">
                                    <Image x:Name="PageImage" Stretch="Fill" IsHitTestVisible="False"
                                           AutomationProperties.Name="Изображение листа PDF"/>
                                    <Canvas x:Name="Overlays" IsHitTestVisible="False"/>
                                </Canvas>
                            </ScrollViewer>
                            <TextBlock x:Name="PreviewMessage" Text="Выберите PDF в списке." TextWrapping="Wrap"
                                       Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="RegionControls" Grid.Row="2" Spacing="5" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="Выделить графы" Click="ToggleRegions"/>
                            <StackPanel x:Name="RegionActions" Orientation="Horizontal" Spacing="5" Visibility="Collapsed">
                                <Button Content="Обозначение" Click="MarkDesignation"/>
                                <Button Content="Наименование" Click="MarkName"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="RegionReadActions" Orientation="Horizontal" Spacing="6" Visibility="Collapsed">
                            <ComboBox x:Name="Orientation" AutomationProperties.Name="Повернуть текст по часовой стрелке" SelectedIndex="0">
                                <ComboBoxItem Content="0°"/><ComboBoxItem Content="90°"/>
                                <ComboBoxItem Content="180°"/><ComboBoxItem Content="270°"/>
                            </ComboBox>
                            <Button x:Name="ReadRegionsButton" Content="Прочитать графы" Click="ReadRegions"/>
                            <TextBlock x:Name="RegionHint" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="Editor" Grid.Row="3" Spacing="7" Visibility="Collapsed">
                        <ComboBox x:Name="CandidatePicker" Header="Варианты распознавания" Visibility="Collapsed"
                                  HorizontalAlignment="Stretch" SelectionChanged="CandidateChanged"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBox Header="Обозначение" Text="{Binding Designation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Column="1" Header="Наименование" Text="{Binding DocumentName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Diagnostic}" TextWrapping="Wrap" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}" AutomationProperties.LiveSetting="Polite"/>
                            <Button Grid.Column="1" Content="Подтвердить значения" Click="ConfirmValues"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="3" ColumnSpacing="14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
            <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                       Style="{StaticResource CaptionTextBlockStyle}" AutomationProperties.LiveSetting="Polite"/>
            <ProgressBar Grid.Column="1" Value="{x:Bind ViewModel.Progress, Mode=OneWay}" Maximum="100"
                         AutomationProperties.Name="Ход анализа"/>
        </Grid>
    </Grid>
</Window>

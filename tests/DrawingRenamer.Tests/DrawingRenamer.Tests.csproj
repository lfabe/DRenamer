<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <PdfFixtureDirectory>$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/fixtures</PdfFixtureDirectory>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DrawingRenamer.Core/DrawingRenamer.Core.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <Compile Include="../../src/DrawingRenamer/DocumentRow.cs" Link="DocumentRow.cs" />
    <Compile Include="../../src/DrawingRenamer/MainViewModel.cs" Link="MainViewModel.cs" />
    <Compile Include="../../src/DrawingRenamer/AppSettings.cs" Link="AppSettings.cs" />
    <Using Include="Xunit" />
    <PdfFixtureName Include="outline-form1.pdf;protected.pdf;scan-form1.pdf;scan-gasket.pdf;scan-connector.pdf;scan-italic.pdf;scan-italic-faded.pdf;scan-rotated.pdf;scan-skewed.pdf;scan-assembly.pdf;scan-nut.pdf;scan-specification.pdf;scan-sideways.pdf" />
    <PdfFixture Include="@(PdfFixtureName->'$(PdfFixtureDirectory)/%(Identity)')" />
    <None Include="@(PdfFixture)" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="GeneratePdfFixtures" BeforeTargets="PrepareForBuild"
          Inputs="../fixtures/generate_scan.py;../fixtures/scan-gasket.jpg;../fixtures/scan-connector.jpg;../fixtures/scan-italic.jpg;../fixtures/scan-italic-faded.jpg;../fixtures/scan-assembly.jpg;../fixtures/scan-nut.jpg;../fixtures/scan-specification.jpg;../fixtures/scan-sideways.jpg"
          Outputs="@(PdfFixture)">
    <Exec Command="python &quot;../fixtures/generate_scan.py&quot; --output &quot;$(PdfFixtureDirectory)&quot;" />
  </Target>
</Project>
